# ==========================================
# CLIPFORGE AI ENVIRONMENT CONFIGURATION
# ==========================================
# All configurations support a strict ₹0 budget.

# 1. Database Connection
# Local Development: SQLite (zero-config, pre-configured fallback)
DATABASE_URL=sqlite:///./clipforge.db

# Production Free Tier: Supabase PostgreSQL (500MB free database)
# Example: postgresql://postgres.xxxx:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# 2. Worker Security
# Secret token required by workers to claim jobs and update status
WORKER_SECRET=clipforge-local-dev-secret-key-replace-in-prod

# Worker lease timeout in seconds (workers missing heartbeats longer than this will forfeit their lease)
WORKER_LEASE_SECONDS=120

# 3. Storage Configuration
# Local storage root path (media, chunks, clips, checkpoints)
STORAGE_DIR=./storage

# 4. Telegram Notifications (Optional - ₹0 Free Bot API)
# Leave empty to run without Telegram notifications.
# To create: Message @BotFather on Telegram -> /newbot -> Copy Token.
# To get your chat ID: Message @userinfobot or run getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 5. Public Application URL (Used in Telegram download links)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
